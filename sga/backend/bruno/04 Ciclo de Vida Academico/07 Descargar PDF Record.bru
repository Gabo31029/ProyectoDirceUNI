meta {
  name: 07 Descargar PDF Record
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/historial/alumnos/{{id_perfil_alumno}}/pdf
  body: none
  auth: none
}

headers {
  X-User-Role: ADMINISTRADOR
  X-User-ID: {{id_admin}}
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("content-type es PDF", function() {
    expect(res.getHeader("content-type")).to.include("application/pdf");
  });
}
