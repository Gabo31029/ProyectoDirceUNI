meta {
  name: POST matrícula sin token → 401
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/matriculas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id_periodo": "{{id_periodo}}"
  }
}

tests {
  test("status code is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
