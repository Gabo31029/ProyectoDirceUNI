meta {
  name: POST retiro duplicado → 409
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/inscripciones/{{inscripcion_id}}/retiro
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
