meta {
  name: GET secciones del periodo (guardar id_seccion)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/oferta/periodos/{{id_periodo}}/secciones
  body: none
  auth: none
}

script:post-response {
  bru.setEnvVar("id_seccion", res.body[0].id);
}

tests {
  test("status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
