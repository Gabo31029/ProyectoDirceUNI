ENVIRONMENT=development

# ─── Supabase Configuration ───────────────────────────────────────────────────
# Dejar DATABASE_URL vacío para usar las variables de abajo, o rellenar directamente
# DATABASE_URL si prefieres una URL de conexión completa.
DATABASE_URL=

# Variables separadas (Recomendado para evitar problemas con contraseñas especiales)
SUPABASE_PROJECT_REF=tu_project_id_aqui
DATABASE_PASSWORD=tu_password_aqui
DATABASE_NAME=postgres

# Configuración adicional del Pooler de Supabase
DATABASE_USE_POOLER=true
SUPABASE_POOLER_REGION=us-west-2
SUPABASE_POOLER_AWS=1
SUPABASE_POOLER_PORT=5432

# ─── Supabase API Keys (Para Auth, Storage, etc.) ─────────────────────────────
SUPABASE_URL=https://tu_project_id_aqui.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# ─── Security & JWT ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=cambiar-esta-clave-en-produccion-minimo-32-caracteres
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Seeds ────────────────────────────────────────────────────────────────────
SEED_ADMIN_CENTRAL_EMAIL=admin.central@sga.local
SEED_ADMIN_CENTRAL_PASSWORD=AdminCentral123!
